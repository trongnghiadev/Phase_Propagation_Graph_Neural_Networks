* text=auto
*.sh  text eol=lf
*.js  text eol=lf
*.py  text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.ps1 text eol=crlf
*.pdf binary
*.png binary
*.parquet binary
# Dữ liệu: giữ nguyên từng byte để sha256 trong data/manifest.yaml luôn khớp
data/**/*.json  -text
data/**/*.jsonl -text
