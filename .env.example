# Chép thành .env (không commit). Giá trị bí mật chỉ đặt ở đây hoặc biến môi trường.
APP_ENV=dev
MONGO_URI=mongodb://localhost:27017
MONGO_DB=vietnam_gis
REDIS_SENTINELS=localhost:26381,localhost:26382,localhost:26383
REDIS_SENTINEL_MASTER=cache
REDIS_LOCK_NODES=localhost:6391,localhost:6392,localhost:6393
LOCK_BACKEND=redlock
# Khoá ký JWT của apps/api (tên biến theo auth.secret_env trong config, mặc định AUTH_SECRET).
# APP_ENV khác dev/test: thiếu hoặc < 32 byte thì API dừng khởi động. Sinh khoá:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
# Proxy tin cậy (IP/CIDR, cách nhau dấu phẩy) được phép đặt X-Forwarded-For; để trống = không tin header này.
TRUSTED_PROXIES=
