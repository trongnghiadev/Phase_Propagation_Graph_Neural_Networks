# --- Cấu hình frontend (apps/web) -------------------------------------------
# Sao chép file này thành `.env.local` rồi điền giá trị thật.
# `.env.local` đã nằm trong `.gitignore` của repo (không được commit).

# URL gốc của API (không có dấu / cuối).
# - Dev: API chạy trực tiếp qua uvicorn, ví dụ http://localhost:8000
# - Qua Nginx của cụm `ha`: http://localhost:8088
# - Khi chạy sau Nginx cùng origin: để trống -> dùng đường dẫn tương đối /api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8088

# Bật hay tắt proxy dev của Next.js (chuyển /api/v1 sang API_BASE_URL).
# - "1": dùng rewrite trong next.config.ts (tiện cho dev, giữ URL gốc trong trình duyệt)
# - "0": gọi thẳng NEXT_PUBLIC_API_BASE_URL từ trình duyệt (cần CORS ở API: origin của web phải
#        nằm trong auth.cors_origins / CORS_ORIGINS; refresh token là cookie httpOnly gửi kèm
#        credentials, dev http cần AUTH_COOKIE_SECURE=false phía API)
NEXT_PUBLIC_API_PROXY=1
# Đích của proxy dev (chỉ đọc phía server Next.js, không lộ ra trình duyệt).
# Bỏ trống thì dùng NEXT_PUBLIC_API_BASE_URL.
API_PROXY_TARGET=

# KHÔNG đặt bí mật (khoá JWT, mật khẩu, token) vào biến NEXT_PUBLIC_*:
# mọi biến NEXT_PUBLIC_* được nhúng vào JavaScript gửi cho trình duyệt.

# Tài khoản demo KHÔNG đặt mật khẩu thật trong repo.
# Mật khẩu được sinh ngẫu nhiên bởi `python -m api.auth.seed --print-passwords`
# và nhập tay khi đăng nhập. Hai biến dưới chỉ dùng cho script kiểm thử tự động
# (không dùng trong giao diện).
DEMO_USERNAME=
DEMO_PASSWORD=
